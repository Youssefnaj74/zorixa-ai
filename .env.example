# Canonical site URL (OAuth redirects, Stripe, metadata). Falls back to NEXT_PUBLIC_APP_URL.
NEXT_PUBLIC_SITE_URL=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: Postgres URI for `npm run apply:billing-migration` (Dashboard → Database → Connection string)
# SUPABASE_DB_URL=

# Dodo Payments (subscriptions + webhooks)
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_RETURN_URL=https://www.zorixaai.com/billing/success
DODO_PAYMENTS_ENVIRONMENT=live_mode
DODO_PRODUCT_STARTER=pdt_0Ngft0RP4JoUHCPakR3JG
DODO_PRODUCT_PRO=pdt_0NgfthB5ymLtXkYxWD8yR
DODO_PRODUCT_CREATOR=pdt_0NgfwucO0G8Anm64IbfaS
DODO_PRODUCT_ULTRA=pdt_0NgfxOGpB9NlTRazoi4os

# Legacy Lemon Squeezy (optional — webhook kept for old orders)
# LEMON_SQUEEZY_WEBHOOK_SECRET=
# NEXT_PUBLIC_LEMON_SQUEEZY_STORE_SLUG=
# NEXT_PUBLIC_LEMON_SQUEEZY_VARIANT_ID=

# Atlas Cloud (generate-video API, video studio / atlas-api). Same name on Vercel: ATLASCLOUD_API_KEY (not ATLAS_CLOUD_API_KEY).
ATLASCLOUD_API_KEY=

# BytePlus ModelArk — Dreamina Seedance 2.0 standard tier (Fast tier stays on Atlas).
BYTEPLUS_API_KEY=
BYTEPLUS_REGION=ap-southeast-1
BYTEPLUS_SEEDANCE_ENABLED=true

# Internal admin dashboard (/dashboard/admin) — comma-separated emails
# ZORIXA_ADMIN_EMAILS=you@zorixaai.com

# ElevenLabs (text-to-speech studio at /audio)
ELEVENLABS_API_KEY=

# Cursor MCP → Zorixa API (same value in zorixa-mcp/.env as ZORIXA_MCP_API_KEY)
ZORIXA_MCP_API_KEY=

# Replicate (add your token to .env.local — never commit secrets)
REPLICATE_API_TOKEN=

# Optional: default is stability-ai/stable-video-diffusion
REPLICATE_MODEL_STABLE_VIDEO=

# Replicate model slugs (can be changed anytime)
REPLICATE_MODEL_UPSCALE=nightmareai/real-esrgan
REPLICATE_MODEL_REMOVE_BG=cjwbw/rembg
REPLICATE_MODEL_ENHANCE=sczhou/codeformer
REPLICATE_MODEL_DENOISE=sczhou/codeformer
REPLICATE_MODEL_VIDEO=

# Set to 1 to disable credit checks and deductions (local testing)
# ZORIXA_CREDITS_DISABLED=1

# Resend (support/contact notifications + purchase confirmation)
# RESEND_API_KEY=

# Analytics (PostHog + optional Google Analytics)
# NEXT_PUBLIC_POSTHOG_KEY=phc_...
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# POSTHOG_API_KEY=phc_...  # same project key — server-side webhook events
# POSTHOG_PERSONAL_API_KEY=phx_...  # for scripts/posthog-onboarding-dashboard.mjs
# POSTHOG_PROJECT_ID=...
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-...
# Affiliate program — Tally embed or external form (see /affiliate)
# NEXT_PUBLIC_AFFILIATE_TALLY_EMBED_URL=https://tally.so/embed/your-form-id?alignLeft=1&hideTitle=1&transparentBackground=1&dynamicHeight=1
# NEXT_PUBLIC_AFFILIATE_FORM_URL=https://tally.so/r/your-form-id
# SUPPORT_NOTIFY_EMAIL=support@zorixaai.com
# RESEND_FROM_ALERTS=Zorixa Alerts <system@zorixaai.com>
# RESEND_FROM_SUPPORT=Zorixa AI <support@zorixaai.com>
# RESEND_FROM_BILLING=Zorixa AI Billing <billing@zorixaai.com>

